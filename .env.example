# Milestone 1 requires no secrets. Future connector credentials belong here.
LIFESCAPE_HOSTED_RUNS_ENABLED=false

# Experimental research tools below are not required or supported for version one.
# Census ACS connector. Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional system-owned geographies for the local research packet adapter queue.
# This is configuration, not user-provided evidence. Keep the JSON keyed by the
# discovery lead IDs and use explicit ACS place FIPS / NOAA station-year values.
LIFESCAPE_RESEARCH_GEOGRAPHIES=

# Optional local discovery adapter. Lifescape sends only the SearchBrief to Claude
# when the user explicitly requests research leads. Claude output is Tier C discovery
# material and cannot affect a gate or score until a human promotes an A/B source.
ANTHROPIC_API_KEY=
LIFESCAPE_ANTHROPIC_MODEL=

# Hosted MCP endpoint (/api/mcp on Vercel). src/lifescape/mcp_http.py HOSTED_ENV lists
# these; if one is missing or unusable, /api/mcp answers 503 with its name. Set the real
# values in the Vercel project, never in this file. See README "Hosted MCP".
# The owner's GitHub login: the only account that gets a token.
OWNER_GITHUB_LOGIN=
# The GitHub OAuth app (callback <origin>/oauth/github/callback) and its client secret.
LIFESCAPE_GITHUB_OAUTH_CLIENT_ID=
LIFESCAPE_GITHUB_OAUTH_CLIENT_SECRET=
# At least 32 characters, such as the output of: openssl rand -base64 48
LIFESCAPE_OAUTH_SIGNING_KEY=
# Store adapter: local for development; the hosted endpoint needs database.
LIFESCAPE_STORE=local
# The Postgres URL for LIFESCAPE_STORE=database (the Vercel Neon integration sets it).
DATABASE_URL=
