# Milestone 1 requires no secrets. Future connector credentials belong here.
LIFESCAPE_HOSTED_RUNS_ENABLED=false

# Milestone 2: Census ACS connector. Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional system-owned geographies for the local research packet adapter queue.
# This is configuration, not user-provided evidence. Keep the JSON keyed by the
# discovery lead IDs and use explicit ACS place FIPS / NOAA station-year values.
LIFESCAPE_RESEARCH_GEOGRAPHIES=

# Optional local discovery adapter. Lifescape sends only the SearchBrief to Claude
# when the user explicitly requests research leads. Claude output is Tier C discovery
# material and cannot affect a gate or score until a human promotes an A/B source.
ANTHROPIC_API_KEY=
LIFESCAPE_ANTHROPIC_MODEL=
